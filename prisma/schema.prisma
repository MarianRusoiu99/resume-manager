// Prisma schema (hybrid-normalized, reset-safe)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum TemplateCategory {
  PROFESSIONAL
  MODERN
  CREATIVE
  ATS_OPTIMIZED
  MINIMAL
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
  COHERE
  MISTRAL
}

enum AiFeatureKey {
  resume
  coverLetter
  enhance
  template
}

enum ApiKeyAuditAction {
  KEY_CREATED
  KEY_ROTATED
  KEY_REVOKED
  KEY_DELETED
  KEY_DECRYPTED // When key is decrypted for use
  KEY_VALIDATED // External API validation
  KEY_USED // When key is used for AI generation
  KEY_SCOPE_CHANGED
}

enum NotificationType {
  RESUME_GENERATED
  COVER_LETTER_GENERATED
  PROFILE_UPDATED
  EXPORT_COMPLETE
  SYSTEM
}

enum AuditAction {
  // Authentication
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE

  // Profile operations
  PROFILE_CREATE
  PROFILE_UPDATE
  PROFILE_DELETE
  PROFILE_SET_DEFAULT
  PROFILE_PUBLISH

  // Resume operations
  RESUME_CREATE
  RESUME_UPDATE
  RESUME_DELETE
  RESUME_GENERATE
  RESUME_EXPORT_PDF

  // Cover letter operations
  COVER_LETTER_CREATE
  COVER_LETTER_UPDATE
  COVER_LETTER_DELETE
  COVER_LETTER_GENERATE

  // Template operations
  TEMPLATE_CREATE
  TEMPLATE_UPDATE
  TEMPLATE_DELETE

  // API key operations
  API_KEY_ADD
  API_KEY_UPDATE
  API_KEY_DELETE

  // Settings
  SETTINGS_UPDATE

  // AI operations
  AI_GENERATE
  AI_VALIDATION_FAILED
  AI_TOKEN_USAGE
}

// -----------------------------------------------------------------------------
// Core: users + auth
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profiles      Profile[]
  resumes       Resume[]
  coverLetters  CoverLetter[]
  sessions      Session[]
  apiProviders  ApiProvider[]
  notifications Notification[]
  auditLogs     AuditLog[]
  aiPreferences UserAiPreference[]
  jobPostings   JobPosting[]

  @@index([email])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Profiles (entity) + ProfileDocument (JSON Resume)
// -----------------------------------------------------------------------------

model Profile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  isDefault  Boolean @default(false)
  isPublic   Boolean @default(false)
  publicSlug String? @unique

  selectedTemplateId String?
  selectedTemplate   ResumeTemplate? @relation("ProfileSelectedTemplate", fields: [selectedTemplateId], references: [id], onDelete: SetNull)

  document ProfileDocument?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resumes   Resume[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isDefault])
  @@index([publicSlug])
  @@index([updatedAt])
  @@index([selectedTemplateId])
}

model ProfileDocument {
  id        String  @id @default(cuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  document Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

// -----------------------------------------------------------------------------
// Templates
// -----------------------------------------------------------------------------

model ResumeTemplate {
  id          String           @id @default(cuid())
  name        String
  category    TemplateCategory
  description String

  htmlTemplate String @db.Text
  cssStyles    String @db.Text

  previewUrl String?
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profiles Profile[] @relation("ProfileSelectedTemplate")
  resumes  Resume[]

  @@index([category])
  @@index([isPublic])
}

// -----------------------------------------------------------------------------
// Job targeting normalization
// -----------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobPostings JobPosting[]

  @@index([name])
}

model JobPosting {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  title       String?
  sourceUrl   String?
  postedAt    DateTime?
  description String    @db.Text

  resumes      Resume[]
  coverLetters CoverLetter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([companyId])
  @@index([title])
}

// -----------------------------------------------------------------------------
// Resumes (entity) + ResumeDocument (JSON Resume)
// -----------------------------------------------------------------------------

model Resume {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  jobPostingId String?
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  templateId String?
  template   ResumeTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  metadata Json

  document ResumeDocument?

  coverLetter CoverLetter?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, updatedAt])
  @@index([profileId])
  @@index([jobPostingId])
  @@index([templateId])
}

model ResumeDocument {
  id       String @id @default(cuid())
  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  document Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
}

// -----------------------------------------------------------------------------
// Cover letters (entity) + document content
// -----------------------------------------------------------------------------

model CoverLetter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeId String? @unique
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  jobPostingId String?
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  content String @db.Text

  metadata Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, updatedAt])
  @@index([resumeId])
  @@index([jobPostingId])
}

// -----------------------------------------------------------------------------
// API key management + model catalog + user preferences
// -----------------------------------------------------------------------------

model ApiProvider {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  provider     ProviderType
  encryptedKey String       @db.Text
  isActive     Boolean      @default(true)

  keyVersion Int       @default(1)
  revokedAt  DateTime?
  usageCount Int       @default(0)
  lastUsedIp String?
  scopes     String[]  @default(["generate", "validate"])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  models      ApiModel[]
  auditLogs   ApiKeyAuditLog[]
  preferences UserAiPreference[]

  @@index([userId, provider])
  @@index([userId, isActive])
  @@index([revokedAt])
}

model ApiModel {
  id         String      @id @default(cuid())
  providerId String
  provider   ApiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  modelKey    String
  displayName String?
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences UserAiPreference[]

  @@unique([providerId, modelKey])
  @@index([providerId])
}

model UserAiPreference {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature AiFeatureKey

  providerId String
  provider   ApiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  modelId String?
  model   ApiModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, feature])
  @@index([userId])
  @@index([providerId])
  @@index([modelId])
}

model ApiKeyAuditLog {
  id         String      @id @default(cuid())
  providerId String
  provider   ApiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  action       ApiKeyAuditAction
  userId       String
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  success      Boolean           @default(true)
  errorMessage String?
  timestamp    DateTime          @default(now())

  @@index([providerId, timestamp(sort: Desc)])
  @@index([userId, timestamp(sort: Desc)])
  @@index([action, timestamp(sort: Desc)])
}

// -----------------------------------------------------------------------------
// Notifications + audit (keep flexible)
// -----------------------------------------------------------------------------

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String
  isRead  Boolean          @default(false)

  actionUrl   String?
  actionLabel String?

  resourceType String?
  resourceId   String?

  metadata  Json?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action AuditAction

  resourceType String?
  resourceId   String?

  ipAddress String?
  userAgent String?
  metadata  Json?

  success      Boolean @default(true)
  errorMessage String?

  timestamp DateTime @default(now())

  @@index([userId, timestamp(sort: Desc)])
  @@index([action, timestamp(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([timestamp(sort: Desc)])
}
