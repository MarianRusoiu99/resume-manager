// This is your Prisma schema file for AI Resume Optimizer Platform
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User authentication and account management
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  profiles      UserProfile[]
  resumes       GeneratedResume[]
  coverLetters  CoverLetter[]
  sessions      Session[]
  apiProviders  ApiProvider[]
  
  @@index([email])
  @@index([createdAt])
}

// User professional profile and experience
// UPDATED: Support multiple profiles per user with public sharing
model UserProfile {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name            String   // Profile name (e.g., "Software Engineer", "Product Manager")
  isDefault       Boolean  @default(false) // One default profile per user
  isPublic        Boolean  @default(false) // Public sharing enabled
  publicSlug      String?  @unique // Unique slug for public URL
  resume          Json     // JSON Resume v1.0.0 format
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isDefault])
  @@index([publicSlug])
  @@index([updatedAt])
}


// Generated resumes with AI and user edits
// REFACTORED: Removed templateCustomization and pdfUrl (generate PDF on-demand)
model GeneratedResume {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  jobDescription  String   @db.Text
  jobMetadata     Json?    // {company, title, url, postedDate}
  resume          Json     // JSON Resume v1.0.0 format
  templateId      String?
  template        ResumeTemplate? @relation(fields: [templateId], references: [id])
  coverLetter     String?  @db.Text
  
  // Relation to standalone cover letters
  coverLetters    CoverLetter[]
  
  metadata        Json     // {model, tokens, score, generationTime}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, updatedAt])
  @@index([templateId])
}

// Standalone Cover Letters (can be linked to a resume or independent)
model CoverLetter {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content         String   @db.Text  // Markdown formatted cover letter (for preview)
  contentJson     String?  @db.Text  // Yoopta editor JSON state (for editing with formatting)
  jobDescription  String   @db.Text
  jobTitle        String?
  companyName     String?
  
  // Optional link to a resume (if generated together)
  resumeId        String?
  resume          GeneratedResume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  
  metadata        Json     // {model, tokens, generationTime, personalInstructions}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, updatedAt])
  @@index([resumeId])
}

// Resume templates (professional layouts)
// REFACTORED: Simple HTML/CSS templates (like JSON Resume themes)
model ResumeTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String   // 'professional', 'modern', 'creative', 'ats-optimized', 'minimal'
  description String
  
  // HTML template with Handlebars placeholders: {{basics.name}}, {{basics.email}}, etc.
  htmlTemplate String  @db.Text
  
  // CSS styles for the template
  cssStyles    String  @db.Text
  
  previewUrl  String?
  isPublic    Boolean  @default(true)
  version     String   @default("1.0.0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  resumes     GeneratedResume[]
  
  @@index([category])
  @@index([isPublic])
}

// Authentication sessions
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
  
  @@index([userId])
}

// API Provider and Key Management
// Stores encrypted API keys for different AI providers
model ApiProvider {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name         String   // User-friendly name (e.g., "My OpenAI Key", "Claude API")
  provider     String   // Provider type: "openai", "anthropic", "google", etc.
  encryptedKey String   @db.Text // AES-256-GCM encrypted API key
  keyPreview   String   // First 8 chars of key for display (e.g., "sk-proj-...")
  
  models       Json     // Available models for this provider ["gpt-4", "gpt-3.5-turbo"]
  isActive     Boolean  @default(true) // Can be disabled without deleting
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastUsedAt   DateTime? // Track when key was last used
  
  @@index([userId])
  @@index([userId, isActive])
  @@index([provider])
}
