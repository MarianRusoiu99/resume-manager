// This is your Prisma schema file for AI Resume Optimizer Platform
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums for type safety
enum TemplateCategory {
  PROFESSIONAL
  MODERN
  CREATIVE
  ATS_OPTIMIZED
  MINIMAL
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
  COHERE
  MISTRAL
}

// User authentication and account management
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profiles      UserProfile[]
  resumes       GeneratedResume[]
  coverLetters  CoverLetter[]
  sessions      Session[]
  apiProviders  ApiProvider[]
  notifications Notification[]
  aiSettings    UserAISettings?

  @@index([email])
  @@index([createdAt])
}

// AI Model Preferences per feature
// Stores user's preferred API provider and model for each AI feature
model UserAISettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Resume Generation preferences
  resumeProviderId String? // Reference to ApiProvider.id
  resumeModelId    String? // Model ID within that provider

  // Cover Letter Generation preferences
  coverLetterProviderId String?
  coverLetterModelId    String?

  // Resume Enhancement/AI Enhance preferences
  enhanceProviderId String?
  enhanceModelId    String?

  // Template Parsing preferences
  templateProviderId String?
  templateModelId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// User professional profile and experience
// UPDATED: Support multiple profiles per user with public sharing
model UserProfile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String // Profile name (e.g., "Software Engineer", "Product Manager")
  isDefault  Boolean @default(false) // One default profile per user
  isPublic   Boolean @default(false) // Public sharing enabled
  publicSlug String? @unique // Unique slug for public URL
  resume     Json // JSON Resume v1.0.0 format

  templateId       String? // Remember user's preferred template for this profile
  selectedTemplate ResumeTemplate? @relation("ProfileTemplates", fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, isDefault])
  @@index([publicSlug])
  @@index([updatedAt])
  @@index([templateId])
}

// Generated resumes with AI and user edits
// REFACTORED: Removed templateCustomization and pdfUrl (generate PDF on-demand)
model GeneratedResume {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobDescription String @db.Text
  jobMetadata    Json? // {company, title, url, postedDate}
  resume         Json // JSON Resume v1.0.0 format

  templateId String?
  template   ResumeTemplate? @relation("ResumeTemplates", fields: [templateId], references: [id], onDelete: SetNull)

  coverLetterId String?      @unique
  coverLetter   CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)

  // Relation to standalone cover letters

  metadata  Json // {model, tokens, score, generationTime}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, updatedAt])
}

// Standalone Cover Letters (can be linked to a resume or independent)
model CoverLetter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content        String  @db.Text // Markdown formatted cover letter (for preview)
  jobDescription String  @db.Text
  jobTitle       String?
  companyName    String?

  // Optional back-reference to a generated resume that references this cover letter
  generatedResume GeneratedResume?

  metadata  Json // {model, tokens, generationTime, personalInstructions}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, updatedAt])
}

// Resume templates (professional layouts)
model ResumeTemplate {
  id          String           @id @default(cuid())
  name        String
  category    TemplateCategory
  description String

  // HTML template with Handlebars placeholders: {{basics.name}}, {{basics.email}}, etc.
  htmlTemplate String @db.Text

  // CSS styles for the template
  cssStyles String @db.Text

  previewUrl String?
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userProfiles     UserProfile[]     @relation("ProfileTemplates")
  generatedResumes GeneratedResume[] @relation("ResumeTemplates")

  @@index([category])
  @@index([isPublic])
}

// Authentication sessions
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// API Provider and Key Management
model ApiProvider {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String // User-friendly name (e.g., "My OpenAI Key")
  provider     ProviderType // Provider type enum
  encryptedKey String       @db.Text // AES-256-GCM encrypted API key
  models       String[] // Array of available model IDs from the provider
  isActive     Boolean      @default(true)

  // Security enhancements
  keyVersion   Int       @default(1) // For key rotation tracking
  revokedAt    DateTime? // Soft revocation without deletion
  usageCount   Int       @default(0) // Track usage frequency
  lastUsedIp   String?   // Last IP that used this key
  scopes       String[]  @default(["generate", "validate"]) // Permission scopes

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?

  auditLogs  ApiKeyAuditLog[]

  @@index([userId, provider])
  @@index([userId, isActive])
  @@index([revokedAt])
}

// API Key Audit Log - tracks all sensitive key operations
model ApiKeyAuditLog {
  id         String   @id @default(cuid())
  providerId String
  provider   ApiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  
  action     ApiKeyAuditAction
  userId     String
  ipAddress  String?
  userAgent  String?
  
  // Additional context
  metadata   Json?    // {modelUsed, tokensConsumed, endpoint, etc.}
  success    Boolean  @default(true)
  errorMessage String?
  
  timestamp  DateTime @default(now())

  @@index([providerId, timestamp(sort: Desc)])
  @@index([userId, timestamp(sort: Desc)])
  @@index([action, timestamp(sort: Desc)])
}

// Enum for API key audit actions
enum ApiKeyAuditAction {
  KEY_CREATED
  KEY_ROTATED
  KEY_REVOKED
  KEY_DELETED
  KEY_DECRYPTED  // When key is decrypted for use
  KEY_VALIDATED  // External API validation
  KEY_USED       // When key is used for AI generation
  KEY_SCOPE_CHANGED
}

// Notification types
enum NotificationType {
  RESUME_GENERATED
  COVER_LETTER_GENERATED
  PROFILE_UPDATED
  EXPORT_COMPLETE
  SYSTEM
}

// User notifications
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)

  // Action data - allows clicking to navigate
  actionUrl String?          // URL to navigate to when clicked
  actionLabel String?        // Button text (e.g., "View Resume", "Open Cover Letter")

  // Resource reference for linking
  resourceType String?       // e.g., "resume", "cover-letter", "profile"
  resourceId   String?       // ID of the linked resource

  // Metadata for additional context
  metadata  Json?            // {jobTitle, companyName, etc.}

  createdAt DateTime         @default(now())
  expiresAt DateTime?        // Optional expiration

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// Enum for audit log actions
enum AuditAction {
  // Authentication
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  
  // Profile operations
  PROFILE_CREATE
  PROFILE_UPDATE
  PROFILE_DELETE
  PROFILE_SET_DEFAULT
  PROFILE_PUBLISH
  
  // Resume operations
  RESUME_CREATE
  RESUME_UPDATE
  RESUME_DELETE
  RESUME_GENERATE
  RESUME_EXPORT_PDF
  
  // Cover letter operations
  COVER_LETTER_CREATE
  COVER_LETTER_UPDATE
  COVER_LETTER_DELETE
  COVER_LETTER_GENERATE
  
  // Template operations
  TEMPLATE_CREATE
  TEMPLATE_UPDATE
  TEMPLATE_DELETE
  
  // API key operations
  API_KEY_ADD
  API_KEY_UPDATE
  API_KEY_DELETE
  
  // Settings
  SETTINGS_UPDATE
}

// Audit Log for security and compliance tracking
model AuditLog {
  id        String      @id @default(cuid())
  userId    String?     // Nullable for anonymous/failed auth attempts
  action    AuditAction
  
  // Resource being acted upon
  resourceType String?  // e.g., "profile", "resume", "cover-letter"
  resourceId   String?  // ID of the resource
  
  // Request metadata
  ipAddress    String?
  userAgent    String?
  
  // Additional context (JSON for flexibility)
  metadata     Json?    // {details, previousValue, newValue, etc.}
  
  // Success/failure tracking
  success      Boolean  @default(true)
  errorMessage String?
  
  timestamp    DateTime @default(now())

  @@index([userId, timestamp(sort: Desc)])
  @@index([action, timestamp(sort: Desc)])
  @@index([resourceType, resourceId])
  @@index([timestamp(sort: Desc)])
}
