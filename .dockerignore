# =============================================================================
# Docker Ignore - Exclude files from build context
# =============================================================================

# Dependencies (installed fresh in container)
node_modules
npm-debug.log
yarn-error.log

# Build outputs
.next
out
dist
build

# Version control
.git
.gitignore

# Docker files (prevent recursive copy)
Dockerfile
docker-compose*.yml
.dockerignore

# Documentation
README.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
LICENSE
docs/

# IDE and editor files
.idea
.vscode
*.swp
*.swo
.DS_Store

# Test files
coverage/
.nyc_output
playwright-report/
test-results/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
vitest.config.ts
vitest.setup.ts
playwright.config.ts

# Environment files (secrets should be passed at runtime)
.env
.env.*
!.env.example

# TypeScript build info
*.tsbuildinfo

# Logs
logs
*.log

# Temporary files
tmp/
temp/
