# ==========================================
# Resume Optimizer - Environment Configuration
# ==========================================
# Copy this file to .env and configure the values for your environment

# ==========================================
# Node Environment
# ==========================================
# Options: "development", "production", "test"
# Default: "development"
NODE_ENV="development"

# ==========================================
# CRITICAL: Authentication & Security (REQUIRED in production)
# ==========================================
# Secret key for NextAuth.js session encryption
# REQUIRED: Must be at least 32 characters
# Generate with: openssl rand -base64 32
# WARNING: Change this in production - do NOT use default value!
NEXTAUTH_SECRET="your-nextauth-secret-key-here-min-32-chars"

# 32+ character key for encrypting API keys at rest
# REQUIRED: Protects user API keys in the database
# Generate with: openssl rand -hex 32
# WARNING: Change this in production - do NOT use default value!
ENCRYPTION_KEY="your-encryption-key-here-minimum-32-characters"

# Base URL for your application
# REQUIRED in production to prevent CSRF attacks
# Example: https://resume.example.com
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# CRITICAL: Database Configuration (REQUIRED)
# ==========================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# REQUIRED in production
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# ==========================================
# CRITICAL: Network Security (REQUIRED in production)
# ==========================================
# Comma-separated list of trusted hostnames/IPs for API requests
# Prevents SSRF attacks and unauthorized API access
# Format: host1.com,host2.com,192.168.1.1
# Example: "api.openai.com,api.anthropic.com,localhost:3000"
# REQUIRED in production if accepting user input for API endpoints
TRUSTED_HOSTS="localhost:3000,localhost:3001"

# ==========================================
# Redis Configuration (OPTIONAL but RECOMMENDED)
# ==========================================
# Redis is used for:
# - Rate limiting (shared across multiple servers)
# - Session storage
# - Caching
# - Pub/sub for real-time features
#
# If not set, falls back to in-memory storage
# WARNING: In-memory storage is NOT suitable for multi-instance deployments
#
# Format: redis://[[username][:password]@]host[:port][/db-number]
# Examples:
#   Local: redis://localhost:6379
#   With password: redis://:mypassword@localhost:6379
#   Remote: redis://username:password@redis.example.com:6379/0
REDIS_URL="redis://localhost:6379"

# Optional: Key prefix for all Redis keys (useful for sharing Redis with other apps)
# Default: "resume-optimizer:"
REDIS_KEY_PREFIX="resume-optimizer:"

# ==========================================
# Application Settings (OPTIONAL)
# ==========================================
# Application version (for display and analytics)
# Default: "1.0.0"
APP_VERSION="1.0.0"

# Application name (for display in UI)
# Default: "Resume Manager"
APP_NAME="Resume Manager"

# ==========================================
# Logging Configuration (OPTIONAL)
# ==========================================
# Server-side log level
# Options: "debug", "info", "warn", "error"
# Default: "info"
LOG_LEVEL="info"

# Client-side (public) log level
# Options: "debug", "info", "warn", "error"
# Default: "warn"
# NOTE: This value is bundled into the client JavaScript and visible to users
NEXT_PUBLIC_LOG_LEVEL="warn"

# ==========================================
# Feature Flags (OPTIONAL)
# ==========================================
# Enable bundle analysis on build
# Set to "true" to analyze bundle size
ANALYZE="false"