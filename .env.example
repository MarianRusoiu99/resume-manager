# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://user:password@localhost:15432/resume_optimizer"

# Authentication
# Secret key for NextAuth.js session encryption
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-here-min-32-chars"

# Base URL for your application
NEXTAUTH_URL="http://localhost:3000"

# API Key Encryption
# 32+ character key for encrypting API keys at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-encryption-key-here-minimum-32-characters"

# Optional: Logging
# Set to "development" for detailed logs, "production" for minimal logs
NODE_ENV="development"
