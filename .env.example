# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Redis Configuration (Optional)
# If not set, falls back to in-memory storage (not suitable for multi-instance deployments)
# Format: redis://[[username][:password]@]host[:port][/db-number]
# REDIS_URL="redis://localhost:6379"

# Optional: Key prefix for all Redis keys (useful for sharing Redis with other apps)
# REDIS_KEY_PREFIX="resume-optimizer:"

# Authentication
# Secret key for NextAuth.js session encryption
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-here-min-32-chars"

# Base URL for your application
NEXTAUTH_URL="http://localhost:3000"

# API Key Encryption
# 32+ character key for encrypting API keys at rest
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-encryption-key-here-minimum-32-characters"

# Optional: Logging
# Set to "development" for detailed logs, "production" for minimal logs
NODE_ENV="development"
