# ==========================================
# Resume Optimizer - Environment Configuration
# ==========================================
# Copy this file to .env and configure the values for your environment

# ==========================================
# Node Environment
# ==========================================
# Options: "development", "production", "test"
# Default: "development"
NODE_ENV="development"

# ==========================================
# Database Configuration (REQUIRED)
# ==========================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# REQUIRED in production
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# ==========================================
# Authentication (REQUIRED in production)
# ==========================================
# Secret key for NextAuth.js session encryption
# REQUIRED: Must be at least 32 characters
# Generate with: openssl rand -base64 32
# WARNING: Change this in production - do NOT use default value!
NEXTAUTH_SECRET="your-nextauth-secret-key-here-min-32-chars"

# Base URL for your application
# RECOMMENDED: Set this in production to your domain
# Example: https://resume.example.com
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# API Key Encryption (REQUIRED in production)
# ==========================================
# 32+ character key for encrypting API keys at rest
# REQUIRED: Protects user API keys in the database
# Generate with: openssl rand -hex 32
# WARNING: Change this in production - do NOT use default value!
ENCRYPTION_KEY="your-encryption-key-here-minimum-32-characters"

# ==========================================
# Redis Configuration (OPTIONAL but RECOMMENDED)
# ==========================================
# Redis is used for:
# - Rate limiting (shared across multiple servers)
# - Session storage
# - Caching
# - Pub/sub for real-time features
#
# If not set, falls back to in-memory storage
# WARNING: In-memory storage is NOT suitable for multi-instance deployments
#
# Format: redis://[[username][:password]@]host[:port][/db-number]
# Examples:
#   Local: redis://localhost:6379
#   With password: redis://:mypassword@localhost:6379
#   Remote: redis://username:password@redis.example.com:6379/0
# REDIS_URL="redis://localhost:6379"

# Optional: Key prefix for all Redis keys (useful for sharing Redis with other apps)
# Default: "resume-optimizer:"
# REDIS_KEY_PREFIX="resume-optimizer:"

# ==========================================
# Production Deployment Notes
# ==========================================
# For production deployments, ensure:
# 1. NODE_ENV is set to "production"
# 2. DATABASE_URL points to your production database
# 3. NEXTAUTH_SECRET is a strong, unique value (NOT the default)
# 4. ENCRYPTION_KEY is a strong, unique value (NOT the default)
# 5. NEXTAUTH_URL is set to your production domain
# 6. REDIS_URL is configured for multi-instance deployments
# 7. All sensitive values are kept secure and not committed to version control
#
# Security Checklist:
# ✓ Change all default secret values
# ✓ Use strong, randomly generated secrets (32+ characters)
# ✓ Never commit .env file to version control
# ✓ Use environment-specific .env files (.env.production, .env.staging)
# ✓ Rotate secrets regularly
# ✓ Use a secrets management service for production (AWS Secrets Manager, etc.)
