# =============================================================================
# Docker Environment Variables
# Copy this file to .env.docker and fill in the values
# =============================================================================

# Application Port (optional, defaults to 3000)
APP_PORT=3000

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=resume_optimizer
DB_PORT=5432

# Authentication (REQUIRED)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-minimum-32-characters

# Public URL of your application
NEXTAUTH_URL=http://localhost:3000

# API Key Encryption (REQUIRED)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-encryption-key-minimum-32-characters
